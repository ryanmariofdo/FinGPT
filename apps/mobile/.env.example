# Copy this file to .env and fill in real values. Never commit .env.
# Must be prefixed EXPO_PUBLIC_ to be readable in client code (Expo convention).

# Supabase project settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Supabase project settings -> API Keys -> Publishable key
EXPO_PUBLIC_SUPABASE_ANON_KEY=[YOUR-PUBLISHABLE-KEY]

# Your FastAPI backend's base URL. On a physical device over Wi-Fi, use your
# machine's local network IP (not localhost/127.0.0.1 — the phone can't reach that).
EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
